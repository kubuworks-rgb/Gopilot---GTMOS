APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
API_PROXY_TARGET=http://127.0.0.1:8000
DATABASE_URL=postgresql+asyncpg://gtm:gtm@127.0.0.1:5432/gtm
REDIS_URL=redis://127.0.0.1:6379/0
# Authentication. AUTH_MODE=demo is local development only; production requires oidc.
# Provider-neutral: any OIDC issuer publishing a standard JWKS document works.
# Only asymmetric algorithms are accepted (RS*/ES*/PS*); HS* is rejected by config
# validation because JWKS public keys must never double as HMAC secrets.
AUTH_MODE=demo
JWT_ISSUER=
JWT_AUDIENCE=
JWKS_URL=
JWKS_CACHE_TTL_SECONDS=600
JWT_ALGORITHMS=RS256
# Example issuer values for a Supabase project (no secret belongs in this file):
#   JWT_ISSUER=https://<project>.supabase.co/auth/v1
#   JWT_AUDIENCE=authenticated
#   JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_URL=
SUPABASE_ANON_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
RESEARCH_MODE=fixture
DEMO_AUTH_ENABLED=true
AGENT_REACH_ENABLED=false
AGENT_REACH_GATEWAY_URL=http://127.0.0.1:8010
RESEARCH_GATEWAY_TOKEN=
RESEARCH_GATEWAY_TIMEOUT_SECONDS=120
AGENT_REACH_VERSION=1.4.2
AGENT_REACH_COMMIT=97e9e63f42c89cbf527386343723c1fde610b4cb
SEARCH_BACKEND=exa_mcp
SEARCH_ENDPOINT=https://www.bing.com/search
EXA_MCP_ENDPOINT=https://mcp.exa.ai/mcp
EXA_API_KEY=
SECONDARY_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search
MINIMUM_GENERAL_SEARCH_RESULTS=3
PRODUCTION_ACCEPTANCE=false
FIRMOGRAPHIC_PROVIDER=public_evidence
FIRMOGRAPHIC_API_KEY=
CANDIDATE_PREQUALIFICATION_HIGH_THRESHOLD=35
CANDIDATE_PREQUALIFICATION_MIDDLE_THRESHOLD=30
CANDIDATE_PREQUALIFICATION_LOW_THRESHOLD=25
EXA_CONTEXT_MAX_CHARACTERS=4000
EXA_MIN_INTERVAL_SECONDS=2
GDELT_SEARCH_ENDPOINT=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_MIN_INTERVAL_SECONDS=6
GDELT_MAX_ATTEMPTS=3
GITHUB_TOKEN=
GATEWAY_FETCH_TIMEOUT_SECONDS=20
GATEWAY_MAX_REDIRECTS=4
GATEWAY_MAX_BYTES=1500000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
MAX_RESEARCH_SEARCHES=60
MAX_RESEARCH_DOCUMENTS=100
MAX_ACCOUNT_CANDIDATES=40
MAX_ACCOUNTS_RESEARCHED=15
MAX_RESEARCH_ELAPSED_SECONDS=900
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
