# GoPilot environment configuration.
#
# Every setting below has a working default. You do not need to copy this file to
# get started: `npm run dev` runs the API in fixture mode with demo auth and the
# web app with dev-mode sign-in, with zero environment variables set and zero API
# keys entered anywhere. Copy this file to `.env` only when you want to change a
# default -- for example, to point the API at real Postgres/Redis, or to switch on
# a real OIDC provider.
#
# BYOA (Bring Your Own Accounts) -- importing accounts you already have and
# researching them against their own official domain -- never requires a search
# provider key. EXA_API_KEY and TAVILY_API_KEY only unlock optional autonomous
# account *discovery*, which stays off by default regardless of whether a key is
# configured. Leave the whole "Search providers" section blank.

# ============================================================================
# Runtime
# ============================================================================

# development | production. Production enforces real auth, a populated gateway
# token, and real Postgres/Redis -- see the "Fails closed" note near the bottom.
APP_ENV=development

# fixture | live. Fixture is a deterministic offline dataset: no database, no
# Redis, no network calls, and the whole product surface works immediately. Live
# binds to real Postgres, Redis, a worker, and the research gateway, and performs
# real HTTP requests to the account domains you import.
RESEARCH_MODE=fixture

LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ============================================================================
# API server
# ============================================================================

API_HOST=127.0.0.1
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
API_PROXY_TARGET=http://127.0.0.1:8000

# Only read when RESEARCH_MODE=live.
DATABASE_URL=postgresql+asyncpg://gtm:gtm@127.0.0.1:5432/gtm
REDIS_URL=redis://127.0.0.1:6379/0

# ============================================================================
# Authentication
# ============================================================================

# demo | oidc. demo is local-only: the caller supplies an X-Demo-User header and
# nothing is verified. It is the default so the product runs with zero setup.
# Production refuses to start with AUTH_MODE other than oidc.
AUTH_MODE=demo
DEMO_AUTH_ENABLED=true

# GoPilot has no password system of its own and authenticates against whatever
# standard OIDC issuer you point it at -- any provider publishing a JWKS document
# works (Supabase, Auth0, Clerk, Keycloak, ...). Only asymmetric signing algorithms
# are accepted; HS* is rejected at startup because a JWKS public key must never
# double as an HMAC shared secret.
#
# For trying real sign-in locally without registering with a provider, this repo
# ships services/dev_oidc -- a test issuer that authenticates nobody and refuses to
# start when APP_ENV=production. Run `npm run dev:oidc` and leave the four
# variables below at these values.
JWT_ISSUER=http://127.0.0.1:9000
JWT_AUDIENCE=gopilot-local
JWKS_URL=http://127.0.0.1:9000/jwks.json
JWT_ALGORITHMS=RS256
JWKS_CACHE_TTL_SECONDS=600

# Consumed by the browser (Next.js), not the API. Mirror the four values above.
NEXT_PUBLIC_AUTH_MODE=demo
NEXT_PUBLIC_OIDC_ISSUER=http://127.0.0.1:9000
NEXT_PUBLIC_OIDC_CLIENT_ID=gopilot-local
NEXT_PUBLIC_OIDC_SCOPE=openid profile email offline_access

# ============================================================================
# Search providers -- optional, never required for BYOA
# ============================================================================

# Leave both blank to run the core workflow exactly as shipped. Configuring one
# only enables AUTONOMOUS_DISCOVERY_EXPERIMENTAL, a separately labelled, always
# off-by-default mode for finding accounts you have not already supplied.
EXA_API_KEY=
TAVILY_API_KEY=
SEARCH_BACKEND=exa_mcp
SEARCH_ENDPOINT=https://www.bing.com/search
EXA_MCP_ENDPOINT=https://mcp.exa.ai/mcp
SECONDARY_SEARCH_PROVIDER=tavily
TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search
MINIMUM_GENERAL_SEARCH_RESULTS=3
EXA_CONTEXT_MAX_CHARACTERS=4000
EXA_MIN_INTERVAL_SECONDS=2

# Also optional. GDELT is an additive public news channel; GitHub raises the
# unauthenticated rate limit for the public GitHub adapter.
GDELT_SEARCH_ENDPOINT=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_MIN_INTERVAL_SECONDS=6
GDELT_MAX_ATTEMPTS=3
GITHUB_TOKEN=
FIRMOGRAPHIC_PROVIDER=public_evidence
FIRMOGRAPHIC_API_KEY=

# ============================================================================
# Research gateway (services/research_gateway)
# ============================================================================

AGENT_REACH_ENABLED=false
AGENT_REACH_GATEWAY_URL=http://127.0.0.1:8010
# Required, 32+ characters, whenever APP_ENV=production -- the gateway retrieves
# arbitrary public URLs on request and refuses to start unauthenticated. Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RESEARCH_GATEWAY_TOKEN=
RESEARCH_GATEWAY_TIMEOUT_SECONDS=120
GATEWAY_FETCH_TIMEOUT_SECONDS=20
GATEWAY_MAX_REDIRECTS=4
GATEWAY_MAX_BYTES=1500000
PRODUCTION_ACCEPTANCE=false

# ============================================================================
# Research and scoring bounds
# ============================================================================

CANDIDATE_PREQUALIFICATION_HIGH_THRESHOLD=35
CANDIDATE_PREQUALIFICATION_MIDDLE_THRESHOLD=30
CANDIDATE_PREQUALIFICATION_LOW_THRESHOLD=25
MAX_RESEARCH_SEARCHES=60
MAX_RESEARCH_DOCUMENTS=100
MAX_ACCOUNT_CANDIDATES=40
MAX_ACCOUNTS_RESEARCHED=15
MAX_RESEARCH_ELAPSED_SECONDS=900
MAX_PAGES_PER_ACCOUNT=8

# ============================================================================
# Multi-tenant limits -- only matter once more than one workspace exists
# ============================================================================

# Every limit below returns an explicit error with a machine-readable code; none
# silently truncate a result.
MAX_ACCOUNTS_PER_IMPORT=100
MAX_ACCOUNTS_PER_WORKSPACE=500
MAX_IMPORTS_PER_DAY=20
MAX_CONCURRENT_RESEARCH_RUNS=2
MAX_WORKSPACES_PER_USER=3
MAX_EXPORT_ROWS=1000

# Invite-gating for a deployment you run yourself and want to keep closed to the
# public. Off by default. If turned on, at least one of the two allow-lists below
# must be non-empty, or the API refuses to start (an empty list would admit no
# one, which is far more likely a misconfiguration than an intent).
PRIVATE_ALPHA_ENABLED=false
PRIVATE_ALPHA_ALLOWED_SUBJECTS=
PRIVATE_ALPHA_ALLOWED_EMAILS=

# AUTONOMOUS_DISCOVERY_EXPERIMENTAL stays off even with a search provider
# configured, until explicitly switched on.
ALLOW_EXPERIMENTAL_DISCOVERY=false

# ============================================================================
# Data retention
# ============================================================================

# Retrieved pages and derived evidence become eligible for deletion after this
# many days. Accounts, briefs and review notes are kept until you delete them.
RESEARCH_RETENTION_DAYS=180
# Not implemented as a background job by design: run scripts/apply_retention.py,
# which previews what it would delete before it deletes anything. Setting this
# true is a startup error.
RETENTION_AUTO_DELETE=false

# ============================================================================
# Worker (services/worker) -- only used when RESEARCH_MODE=live
# ============================================================================

WORKER_NAME=worker-1
WORKER_MAX_ATTEMPTS=3

# ============================================================================
# Production deployment only (deploy/docker-compose.production.yml)
# ============================================================================

WEB_PORT=3000
POSTGRES_USER=gtm
POSTGRES_PASSWORD=
POSTGRES_DB=gtm
OIDC_CLIENT_ID=
OIDC_SCOPE=openid profile email

# Used by the optional TLS reverse-proxy overlay (deploy/docker-compose.tls.yml). Bringing
# the stack up without that overlay serves plain HTTP, which is correct on
# localhost and wrong anywhere else -- see docs/operations/DEPLOYMENT.md.
DOMAIN=
ACME_EMAIL=

# ----------------------------------------------------------------------------
# Fails closed. These are startup errors, not warnings -- a misconfigured
# deployment does not boot rather than silently running unsafe:
#   APP_ENV=production with DEMO_AUTH_ENABLED=true          -> refused
#   APP_ENV=production with AUTH_MODE != oidc                -> refused
#   AUTH_MODE=oidc missing issuer, audience, or JWKS URL      -> refused
#   JWT_ALGORITHMS containing an HMAC algorithm (HS*)         -> refused
#   APP_ENV=production without RESEARCH_GATEWAY_TOKEN         -> refused
#   PRIVATE_ALPHA_ENABLED=true with both allow-lists empty    -> refused
#   RETENTION_AUTO_DELETE=true                                 -> refused
# ----------------------------------------------------------------------------
