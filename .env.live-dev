# Used by `npm run dev:live` only. Switches the API, gateway and worker into live
# mode. Everything else (DATABASE_URL, REDIS_URL, AGENT_REACH_GATEWAY_URL) already
# has a working localhost default in apps/api/app/config.py, so this file needs
# nothing else -- RESEARCH_GATEWAY_TOKEN is only required when APP_ENV=production.
# No secrets belong here; committed deliberately so `dev:live` works out of the box.
RESEARCH_MODE=live
