# Local development against the bundled test OIDC issuer (services/dev_oidc).
# Contains NO secrets: the issuer is localhost, the client is public (PKCE), and
# nothing here is valid anywhere else. Committed deliberately so the sign-in flow
# is reproducible without provisioning a provider.
APP_ENV=development
RESEARCH_MODE=fixture
AUTH_MODE=oidc
DEMO_AUTH_ENABLED=false
JWT_ISSUER=http://127.0.0.1:9000
JWT_AUDIENCE=gopilot-local
JWKS_URL=http://127.0.0.1:9000/jwks.json
JWT_ALGORITHMS=RS256
PRIVATE_ALPHA_ENABLED=true
PRIVATE_ALPHA_ALLOWED_SUBJECTS=alpha-founder,second-founder
